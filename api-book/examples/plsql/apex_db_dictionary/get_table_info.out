# Table: ORB_CATEGORIES

## Columns:
  - CATEGORY_ID - NUMBER NOT NULL [pk]
  - PARENT_CATEGORY_ID - NUMBER [fk]
  - CATEGORY_NAME - VARCHAR2(100) NOT NULL [uk]
  - DESCRIPTION - VARCHAR2(400)
  - DISPLAY_ORDER - NUMBER(3)

## Constraints:
  - ORB_CATEGORIES_PK - PRIMARY KEY (CATEGORY_ID)
  - ORB_CATEGORIES_NAME_UK - UNIQUE (CATEGORY_NAME)
  - ORB_CATEGORIES_PARENT_FK - FOREIGN KEY (PARENT_CATEGORY_ID) -> ORB_CATEGORIES(CATEGORY_ID)
